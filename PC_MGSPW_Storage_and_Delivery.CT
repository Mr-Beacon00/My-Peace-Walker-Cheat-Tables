    46286 The Flower
]]
local MUSIC_ID    = 46283

-- raw Id, 0 means FREE
local targetId1   = 0

-- always 0xFEE6E22E if target is player?
-- 0 means FREE
local targetId2   = 0


-- ========== Slot config ==========
local SLOT_TEMPLATES = {
    [1] = {
        {type = 1, id = 246, count = 1}, -- Fulton Sleep Gas Mine Rank 5 x1
        {type = 1, id = 207, count = 4}, -- Sleep Gas Grenade Rank 1 x4
        {type = 0, id = 244, count = 4}, -- Future Curry Rank 5 x4
        {type = 1, id = 231, count = 4}, -- Anti-tank Mine Rank 1 x4
        {type = 0, id = 269, count = 1}, -- Ballistic Shield (Red) Rank 1 x1
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
    },
    [2] = {
        {type = 1, id = 246, count = 1}, -- Fulton Sleep Gas Mine Rank 5 x1
        {type = 1, id = 207, count = 4}, -- Sleep Gas Grenade Rank 1 x4
        {type = 0, id = 244, count = 4}, -- Future Curry Rank 5 x4
        {type = 1, id = 231, count = 4}, -- Anti-tank Mine Rank 1 x4
        {type = 0, id = 328, count = 5}, -- Stealth Mat Rank 1 x5
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
    },
    [3] = {
        {type = 1, id = 246, count = 1}, -- Fulton Sleep Gas Mine Rank 5 x1
        {type = 1, id = 207, count = 4}, -- Sleep Gas Grenade Rank 1 x4
        {type = 0, id = 244, count = 4}, -- Future Curry Rank 5 x4
        {type = 1, id = 231, count = 4},  -- Anti-tank Mine Rank 1 x4
        {type = 1, id = 199, count = 10}, -- Smoke Grenade (Red) Rank 1 x10
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
    },
    [4] = {
        -- not yet
        {type = 1, id = 246, count = 4},
        {type = 1, id = 246, count = 4},
        {type = 0, id = 244, count = 4},
        {type = 0, id = 244, count = 4},
        {type = 0, id = 269, count = 1},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
        {type = 0, id = 0,   count = 0},
    },
}

-- ========== 每个栏的大小（字节）==========
local SLOT_STRIDE = 208

-- ========== 栏1 的基址 ==========
local baseAddr = getAddress('"' .. MODULE .. '"+1108218')
if not baseAddr then
    print("get base failed")
    return
end

-- ========== 相对栏1 的字段偏移 ==========
local OFF = {
    TIMESTAMP   = 0x00,
    MODE        = 0x08,
    YEAR        = 0x0C,
    MUSIC       = 0x10,
    CONTENTS    = 0x14,
    SENDER_ID   = 0x8C,
    SENDER_NAME = 0x9C,
    TARGET_ID   = 0xAC,
    TARGET_NAME = 0xBC,
}

-- ========== 其他基址 ==========
local addr_RemainingWeapons_base = getAddress('"' .. MODULE .. '"+114E35C')
local addr_RemainingItems_base   = getAddress('"' .. MODULE .. '"+11508E0')
local getSenderID                = getAddress('"' .. MODULE .. '"+1142A18')

if not addr_RemainingWeapons_base or not addr_RemainingItems_base or not getSenderID then
    print("get remaining base failed")
    return
end

-- ========== 参数校验 ==========
local MAX_SLOT = #SLOT_TEMPLATES   -- 自动取模板数量，目前是 4
if outbox_slot &lt; 1 or outbox_slot &gt; MAX_SLOT then
    print(string.format("outbox_slot must be 1~%d", MAX_SLOT))
    return
end

-- ========== 检查所有目标栏的 timestamp 是否为空 ==========
for i = 1, outbox_slot do
    local slotBase = baseAddr + (i - 1) * SLOT_STRIDE
    local ts = readQword(slotBase + OFF.TIMESTAMP)
    if ts == nil then
        print(string.format("Get timestamp failed for slot %d", i))
        return
    end
    if ts ~= 0 then
        print(string.format("Outbox %d already exist", i))
        return
    end
end

-- ========== 工具函数 ==========
local function getCountAddr(t, id)
    if t == 0 then
        return addr_RemainingItems_base   + id * 24
    else
        return addr_RemainingWeapons_base + id * 28
    end
end

-- ========== 库存检查：累加所有目标栏的需求 ==========
local totalNeed = {}
for i = 1, outbox_slot do
    for _, data in ipairs(SLOT_TEMPLATES[i]) do
        if data.id ~= 0 and data.count &gt; 0 then
            local key = data.type .. "_" .. data.id
            if not totalNeed[key] then
                totalNeed[key] = {type = data.type, id = data.id, total = 0}
            end
            totalNeed[key].total = totalNeed[key].total + data.count
        end
    end
end

for _, need in pairs(totalNeed) do
    local countAddr = getCountAddr(need.type, need.id)
    local remaining = readInteger(countAddr)
    if remaining == nil then
        print(string.format("Get storage failed: type=%d, id=%d", need.type, need.id))
        return
    end
    if remaining &lt; need.total then
        print(string.format("Storage not enough: type=%d, id=%d, Required=%d, Now=%d",
            need.type, need.id, need.total, remaining))
        return
    end
end

-- ========== 准备写入 ==========
local webkitTimestamp = os.time() * 1000000 + 11644473600000000
local t = os.date("*t")

-- 只读一次发送者 ID
local myId1 = readInteger(getSenderID)     or 0
local myId2 = readInteger(getSenderID + 4) or 0

-- ========== 逐栏写入 ==========
for i = 1, outbox_slot do
    local slotBase = baseAddr + (i - 1) * SLOT_STRIDE

    -- 头部信息
    writeQword  (slotBase + OFF.TIMESTAMP, webkitTimestamp)
    writeInteger(slotBase + OFF.MODE,      8)

    writeSmallInteger(slotBase + OFF.YEAR,     t.year)
    writeByte        (slotBase + OFF.YEAR + 2, t.month)
    writeByte        (slotBase + OFF.YEAR + 3, t.day)

    -- 音乐 ID
    writeInteger(slotBase + OFF.MUSIC, MUSIC_ID)

    -- 目标信息
    writeInteger(slotBase + OFF.TARGET_ID,     targetId1)
    writeInteger(slotBase + OFF.TARGET_ID + 4, targetId2)
    writeString (slotBase + OFF.TARGET_NAME, TARGET_NAME)

    -- 发送者信息
    writeInteger(slotBase + OFF.SENDER_ID,     myId1)
    writeInteger(slotBase + OFF.SENDER_ID + 4, myId2)
    writeString (slotBase + OFF.SENDER_NAME, SENDER_NAME)

    -- 内容栏
    local contentsAddr = slotBase + OFF.CONTENTS
    for j, data in ipairs(SLOT_TEMPLATES[i]) do
        local addr = contentsAddr + (j - 1) * 0xC
        writeInteger(addr,     data.type)
        writeInteger(addr + 4, data.id)
        writeInteger(addr + 8, data.count)
    end

    -- print(string.format("Outbox %d written", i))
end

-- ========== 扣除库存（用累加后的总需求）==========
for _, need in pairs(totalNeed) do
    local countAddr = getCountAddr(need.type, need.id)
    local remaining = readInteger(countAddr)
    if remaining then
        writeInteger(countAddr, remaining - need.total)
    end
end

-- print("Done")
</LuaScript>
</CheatTable>
