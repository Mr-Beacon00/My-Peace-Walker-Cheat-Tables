  <UserdefinedSymbols/>
  <LuaScript>local MODULE = "METAL GEAR SOLID PEACE WALKER.exe"
local MODE = 1   -- 1 = Comrades screen, 2 = CO-OPS date, 3 = Player info in current room

getLuaEngine().mOutput.Clear()

local function webkitToDate(webkitTimestamp)
    if not webkitTimestamp or webkitTimestamp == 0 then
        return nil, nil, nil
    end
    local unixSec = (webkitTimestamp - 11644473600000000) / 1000000
    local t = os.date("*t", unixSec)
    return t.year, t.month, t.day
end

-- ========== 收集一个玩家的数据（不打印）==========
local function collectPlayer(idAddr, nameAddr, needDate)
    if not idAddr or not nameAddr then return nil end

    local rawId = readInteger(idAddr)
    if not rawId or rawId == 0 then return nil end

    local SteamID3  = rawId ~ 0xB739CF89
    local SteamID64 = SteamID3 + 76561197960265728

    local p = {
        name        = readString(nameAddr) or "&lt;no name&gt;",
        camaraderie = readInteger(nameAddr + 0x108) or 0,
        steamID64   = SteamID64,
    }
    if needDate then
        p.webkitTime = readQword(nameAddr + 0x100) or 0
    end
    return p
end

-- ========== 打印一个玩家 ==========
local function printPlayer(p, showDate)
    if showDate then
        local year, month, day = webkitToDate(p.webkitTime)
        print(string.format("%s [%04d-%02d-%02d]", p.name, year or 0, month or 0, day or 0))
    else
        print(p.name)
    end
    print("https://steamcommunity.com/profiles/" .. tostring(p.steamID64))
end


-- ========== 动态列表（MODE 1/2）==========
-- sortByTime: true 则按 webkitTime 从高到低排序
local function handleListMode(baseExpr, sortByTime)
    local base = getAddress(baseExpr)
    if not base then
        print("getAddress failed: " .. baseExpr)
        return
    end

    local playerNumber = readInteger(base)
    if not playerNumber or playerNumber == 0 then
        print("no players")
        return
    end

    local players = {}
    for i = 0, playerNumber - 1 do
        local offset = i * 272
        local p = collectPlayer(base + 24 + offset, base + 8 + offset, true)
        if p then
            players[#players + 1] = p
        end
    end

    if sortByTime then
        table.sort(players, function(a, b)
            return a.webkitTime &gt; b.webkitTime
        end)
    end

    for _, p in ipairs(players) do
        printPlayer(p, true)
    end
end


-- ========== 固定列表（MODE 3）==========
local function handleFixedMode()
    local addrs = {
        '"' .. MODULE .. '"+150E054',
        '"' .. MODULE .. '"+150EBE8',
        '"' .. MODULE .. '"+150F77C',
        '"' .. MODULE .. '"+1510310',
        '"' .. MODULE .. '"+1510EA4',
        '"' .. MODULE .. '"+1511A38',
    }

    for _, idExpr in ipairs(addrs) do
        local idAddr   = getAddress(idExpr)
        local nameAddr = idAddr and (idAddr + 8)
        local p = collectPlayer(idAddr, nameAddr, false)   -- 不读时间
        if p then printPlayer(p, false) end                 -- 不输出日期
    end
end


-- ========== 分发 ==========
if MODE == 1 then
    handleListMode('"' .. MODULE .. '"+111BEE8', false)
elseif MODE == 2 then
    handleListMode('"' .. MODULE .. '"+110CE08', true)
elseif MODE == 3 then
    handleFixedMode()
else
    print("unknown MODE: " .. tostring(MODE))
end
</LuaScript>
</CheatTable>
